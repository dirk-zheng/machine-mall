# 服务器监听 IP（默认 0.0.0.0 监听所有网卡）
HOST=0.0.0.0

# 服务器端口
PORT=3001

# development 或 production
NODE_ENV=development

# MySQL：仅保存用户、用户行为、询盘和沟通数据
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vendora_b2b
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10
DB_AUTO_SCHEMA=false
EVENT_HASH_SALT=

# 生产环境必填：至少32字符的唯一强随机值
JWT_SECRET=

# 生产环境允许的前端 Origin，多个值以英文逗号分隔（不要填 *）
CORS_ORIGINS=https://www.vendorasystems.com,https://vendorasystems.com
TRUST_PROXY=loopback

# 上线前必须替换为已核验的经营主体和美国业务邮寄地址
LEGAL_BUSINESS_NAME=
BUSINESS_POSTAL_ADDRESS=
PRIVACY_REQUEST_OWNER=
INCIDENT_RESPONSE_EMAIL=
PRODUCT_COMPLIANCE_OWNER=

# 管理员登录（生产环境请使用独立强密码）
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=
ADMIN_NAME=Vendora Systems Admin

# 国际版 Lark 群机器人通知
LARK_NOTIFICATIONS_ENABLED=true
LARK_WEBHOOK_URL=
LARK_WEBHOOK_SECRET=
LARK_REQUEST_TIMEOUT_MS=8000
